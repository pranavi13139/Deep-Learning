import numpy as np
import matplotlib.pyplot as plt
from tensorflow.keras.models import Sequential, Model
from tensorflow.keras.layers import Dense, Input
from tensorflow.keras.optimizers import Adam

np.random.seed(42)

# Create sample real data
real_data = np.random.randn(1000, 2) * 0.5 + 2

# Generator
generator = Sequential([
    Dense(16, activation="relu", input_shape=(2,)),
    Dense(2)
])

# Discriminator
discriminator = Sequential([
    Dense(16, activation="relu", input_shape=(2,)),
    Dense(1, activation="sigmoid")
])

discriminator.compile(
    optimizer=Adam(0.001),
    loss="binary_crossentropy"
)

discriminator.trainable = False

gan_input = Input(shape=(2,))
generated = generator(gan_input)
validity = discriminator(generated)

gan = Model(gan_input, validity)

gan.compile(
    optimizer=Adam(0.001),
    loss="binary_crossentropy"
)

for epoch in range(1000):
    idx = np.random.randint(0, len(real_data), 32)
    real = real_data[idx]

    noise = np.random.randn(32, 2)
    fake = generator.predict(noise, verbose=0)

    discriminator.trainable = True
    discriminator.train_on_batch(
        np.concatenate([real, fake]),
        np.concatenate([
            np.ones((32, 1)),
            np.zeros((32, 1))
        ])
    )

    discriminator.trainable = False

    noise = np.random.randn(32, 2)
    gan.train_on_batch(noise, np.ones((32, 1)))

samples = generator.predict(
    np.random.randn(500, 2),
    verbose=0
)

plt.scatter(real_data[:, 0], real_data[:, 1], label="Real")
plt.scatter(samples[:, 0], samples[:, 1], label="Generated")
plt.title("GAN Sample Generation")
plt.legend()
plt.show()
