import numpy as np
from scipy.stats import entropy

P = np.array([0.4, 0.6])
Q = np.array([0.5, 0.5])

# Entropy
H = entropy(P, base=2)

# Cross-entropy
CE = -np.sum(P * np.log2(Q))

# KL divergence
KL = entropy(P, Q, base=2)

print("Entropy:", H)
print("Cross Entropy:", CE)
print("KL Divergence:", KL)
