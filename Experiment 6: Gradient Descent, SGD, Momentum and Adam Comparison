import numpy as np
import matplotlib.pyplot as plt

def gradient_descent(learning_rate, epochs):
    x = 10.0
    history = []

    for _ in range(epochs):
        gradient = 2 * x
        x = x - learning_rate * gradient
        history.append(x ** 2)

    return history

epochs = 50

gd = gradient_descent(0.1, epochs)
sgd = gradient_descent(0.05, epochs)

plt.plot(gd, label="Gradient Descent")
plt.plot(sgd, label="SGD-style Update")
plt.xlabel("Epoch")
plt.ylabel("Loss")
plt.title("Gradient Descent Comparison")
plt.legend()
plt.show()

print("Final GD loss:", gd[-1])
print("Final SGD-style loss:", sgd[-1])
